const { google } = require('googleapis');

function getAuth() {
  const raw = process.env.GOOGLE_CREDENTIALS;
  if (!raw) throw new Error('GOOGLE_CREDENTIALS não configurada.');
  const creds = JSON.parse(raw);
  return new google.auth.GoogleAuth({
    credentials: creds,
    scopes: [
      'https://www.googleapis.com/auth/drive.file',
      'https://www.googleapis.com/auth/spreadsheets',
    ],
  });
}

function stripDataUrl(value) {
  const m = String(value || '').match(/^data:([^;]+);base64,(.+)$/s);
  if (m) return { mimeType:m[1], base64:m[2] };
  return { mimeType:'application/octet-stream', base64:String(value||'') };
}

const MAX_ANEXO_BYTES = 50 * 1024 * 1024;
const MIME_ANEXOS = new Set([
  'application/pdf', 'image/png', 'image/jpeg', 'image/webp', 'image/gif',
  'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
]);

function validarArquivo(arquivo) {
  if (!arquivo || !arquivo.dataBase64) {
    const e = new Error('Arquivo não informado.'); e.code = 'ERR_VALIDACAO_ARQUIVO'; throw e;
  }
  const { mimeType, base64 } = stripDataUrl(arquivo.dataBase64);
  if (!base64 || !/^[A-Za-z0-9+/\s]+={0,2}$/.test(base64)) {
    const e = new Error('Arquivo com conteúdo Base64 inválido.'); e.code = 'ERR_VALIDACAO_ARQUIVO'; throw e;
  }
  const bytes = Buffer.from(base64.replace(/\s/g, ''), 'base64').length;
  if (!bytes) { const e = new Error('Arquivo sem conteúdo.'); e.code = 'ERR_VALIDACAO_ARQUIVO'; throw e; }
  if (bytes > MAX_ANEXO_BYTES) { const e = new Error('Arquivo acima de 50 MB.'); e.code = 'ERR_VALIDACAO_ARQUIVO'; throw e; }
  if (!MIME_ANEXOS.has(String(mimeType).toLowerCase())) {
    const e = new Error(`Tipo de arquivo não permitido: ${mimeType}.`); e.code = 'ERR_VALIDACAO_ARQUIVO'; throw e;
  }
  return { mimeType, base64, bytes };
}

function normalizarJson(texto) {
  let t=String(texto||'').trim();
  if (!t) { const e = new Error('Resposta de extração vazia.'); e.code = 'ERR_JSON_EXTRACAO'; throw e; }
  t=t.replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,'').trim();
  const inicio=t.indexOf('{'); const fim=t.lastIndexOf('}');
  if(inicio<0 || fim<=inicio) { const e = new Error('Resposta de extração sem JSON válido.'); e.code = 'ERR_JSON_EXTRACAO'; throw e; }
  try { return JSON.parse(t.slice(inicio,fim+1)); }
  catch (_) { const e = new Error('Resposta de extração com JSON inválido.'); e.code = 'ERR_JSON_EXTRACAO'; throw e; }
}

async function salvarArquivoGoogleDrive(arquivo) {
  const {mimeType,base64}=validarArquivo(arquivo);
  if (!process.env.GOOGLE_CREDENTIALS) { const e = new Error('Google Drive indisponível: GOOGLE_CREDENTIALS não configurada.'); e.code = 'ERR_INTEGRACAO_CONFIG'; throw e; }
  const auth=await getAuth().getClient();
  const drive=google.drive({version:'v3',auth});
  const buffer=Buffer.from(base64,'base64');
  const folderId=process.env.DRIVE_FOLDER_ID || undefined;
  const metadata={name:arquivo.nome||arquivo.name||`anexo-${Date.now()}`,mimeType};
  if(folderId) metadata.parents=[folderId];
  const upload=await drive.files.create({resource:metadata,media:{mimeType,body:require('stream').Readable.from(buffer)},fields:'id,name,webViewLink,webContentLink'});
  return {fileId:upload.data.id,nome:upload.data.name,url:upload.data.webViewLink||upload.data.webContentLink||''};
}

const PROMPT_EXTRACAO = (tipoDocumento) =>
  `Você é o extrator documental do Assistente SAC Grupo Chiacchio.\nTipo do documento: ${tipoDocumento}.\nExtraia somente informações explicitamente presentes no documento. Nunca invente valores. Se um campo não estiver presente, retorne string vazia.\n\nRetorne SOMENTE JSON válido com este formato:\n` +
  (tipoDocumento === 'RNC'
    ? JSON.stringify({numeroRnc:'',manifestacaoOrigem:'',dataAbertura:'',empresa:'',setor:'',competencia:'',naoConformidade:'',causaRaiz:'',subcausa:'',acaoCorretiva:'',acaoPreventiva:'',responsavel:'',prazo:'',prioridade:'',status:'',observacoes:''},null,2)
    : JSON.stringify({dataRegistro:'',numeroReclamacao:'',empresaReclamante:'',empresaReclamada:'',cnpj:'',contato:'',telefone:'',email:'',canal:'',tipoManifestacao:'',descricao:'',produto:'',lote:'',nfe:'',quantidade:'',valor:'',procedencia:'',justificativa:'',setor:'',observacoes:''},null,2));

async function _uploadOpenAI(base64, mimeType, nome, apiKey) {
  // Upload para Files API (purpose: user_data) e retorna file_id
  const buffer = Buffer.from(base64, 'base64');
  const boundary = `----FormBoundary${Date.now().toString(16)}`;
  const filename = nome || 'documento.pdf';
  const bodyParts = [
    `--${boundary}\r\nContent-Disposition: form-data; name="purpose"\r\n\r\nuser_data`,
    `--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="${filename}"\r\nContent-Type: ${mimeType}\r\n\r\n`,
  ];
  const parts = [
    Buffer.from(bodyParts[0] + '\r\n'),
    Buffer.from(bodyParts[1]),
    buffer,
    Buffer.from(`\r\n--${boundary}--\r\n`),
  ];
  const body = Buffer.concat(parts);
  const resp = await fetch('https://api.openai.com/v1/files', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${apiKey}`,
      'Content-Type': `multipart/form-data; boundary=${boundary}`,
    },
    body,
  });
  const raw = await resp.text();
  if (!resp.ok) throw new Error(`Files API ${resp.status}: ${raw.slice(0, 400)}`);
  return JSON.parse(raw).id;
}

async function _deleteOpenAIFile(fileId, apiKey) {
  fetch(`https://api.openai.com/v1/files/${fileId}`, {
    method: 'DELETE',
    headers: { 'Authorization': `Bearer ${apiKey}` },
  }).catch(() => {});
}

async function extrairDadosDocumento(arquivo, tipoDocumento) {
  validarArquivo(arquivo);
  if (!process.env.OPENAI_API_KEY) { const e = new Error('IA indisponível: OPENAI_API_KEY não configurada.'); e.code = 'ERR_INTEGRACAO_CONFIG'; throw e; }
  const apiKey = process.env.OPENAI_API_KEY;
  const { mimeType, base64 } = stripDataUrl(arquivo.dataBase64);
  const modelo = process.env.OPENAI_EXTRACTION_MODEL || 'gpt-4o';
  const isImage = /^image\//i.test(mimeType);
  const prompt = PROMPT_EXTRACAO(tipoDocumento);

  if (isImage) {
    // Chat Completions API com vision — formato estável e amplamente suportado
    const resp = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${apiKey}` },
      body: JSON.stringify({
        model: modelo,
        messages: [{
          role: 'user',
          content: [
            { type: 'text', text: prompt },
            { type: 'image_url', image_url: { url: `data:${mimeType};base64,${base64}`, detail: 'high' } },
          ],
        }],
        max_tokens: 3000,
      }),
    });
    const raw = await resp.text();
    if (!resp.ok) throw new Error(`OpenAI ${resp.status}: ${raw.slice(0, 400)}`);
    const data = JSON.parse(raw);
    return normalizarJson(data.choices?.[0]?.message?.content || '{}');
  }

  // Arquivos não-imagem (PDF, DOCX…): upload via Files API, depois Responses API com file_id
  const fileId = await _uploadOpenAI(base64, mimeType, arquivo.nome || arquivo.name, apiKey);
  try {
    const resp = await fetch('https://api.openai.com/v1/responses', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${apiKey}` },
      body: JSON.stringify({
        model: modelo,
        input: [{
          role: 'user',
          content: [
            { type: 'input_text', text: prompt },
            { type: 'input_file', file_id: fileId },
          ],
        }],
        max_output_tokens: 3000,
      }),
    });
    const raw = await resp.text();
    if (!resp.ok) throw new Error(`OpenAI ${resp.status}: ${raw.slice(0, 400)}`);
    const data = JSON.parse(raw);
    const texto = data.output_text || (data.output || []).flatMap(x => x.content || []).map(x => x.text || '').join('');
    return normalizarJson(texto);
  } finally {
    _deleteOpenAIFile(fileId, apiKey);
  }
}

module.exports={salvarArquivoGoogleDrive,extrairDadosDocumento,validarArquivo,normalizarJson,MAX_ANEXO_BYTES};
