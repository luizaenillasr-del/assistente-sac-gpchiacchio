{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/data/**"
    }
  },
  "rewrites": [
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/relatorio-publico/:path*", "destination": "/api/index.js" },
    { "source": "/pesquisa/:path*", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
