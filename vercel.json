{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(logo-chiacchio\\.png|simbolo-vermelho\\.png|simbolo-branco\\.png|fichas\\.html)", "dest": "/public/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/relatorio-publico/(.*)", "dest": "/api/index.js" },
    { "src": "/pesquisa/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
