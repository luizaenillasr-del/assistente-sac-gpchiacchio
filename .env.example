# ================================================================
# VARIÁVEIS DE AMBIENTE — Assistente SAC
# Copie para .env.local (nunca commite com valores reais)
# ================================================================

# ─── Google Sheets (legado — permanece durante migração) ────────
SPREADSHEET_ID=sua_spreadsheet_id_aqui
GOOGLE_CREDENTIALS={"type":"service_account",...}

# ─── Auth ───────────────────────────────────────────────────────
SESSION_SECRET=um_segredo_longo_aleatorio_aqui

# ─── PostgreSQL / Neon ──────────────────────────────────────────
# URL pooled (uso normal da aplicação — Vercel serverless)
DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/dbname?sslmode=require&pgbouncer=true

# URL direta (apenas para prisma migrate — não usar na aplicação)
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxx-pooler.neon.tech/dbname?sslmode=require

# ─── IA ─────────────────────────────────────────────────────────
# Provider: anthropic | openai (obrigatório se quiser IA)
AI_PROVIDER=anthropic

# Anthropic (se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (se AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# ─── Ambiente ───────────────────────────────────────────────────
NODE_ENV=production
